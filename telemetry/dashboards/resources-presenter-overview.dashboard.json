{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Cumulative count of successful and failed service startups since pod creation. Uses raw counter values (no rate/increase) because this metric is emitted exactly once at startup.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(resources_presenter_startup_success_total)",
          "legendFormat": "success",
          "refId": "A"
        },
        {
          "expr": "sum(resources_presenter_startup_failure_total)",
          "legendFormat": "failure",
          "refId": "B"
        }
      ],
      "title": "Startup",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum by (handler, method) (rate(resources_presenter_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{handler}} {{method}}",
          "refId": "A"
        }
      ],
      "title": "HTTP Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (handler, stage) (rate(resources_presenter_http_errors_total[$__rate_interval]))",
          "legendFormat": "{{handler}} {{stage}}",
          "refId": "A"
        }
      ],
      "title": "HTTP Error Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "End-to-end HTTP handler latency at p50, p75, p95, and p99. Does NOT include time spent in upstream middleware (JWT validation, UserConfig). Custom histogram buckets (0.05 s … 10 s) provide accurate interpolation in the 1–6 s range.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 4,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, handler) (rate(resources_presenter_http_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{handler}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.75, sum by (le, handler) (rate(resources_presenter_http_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p75 {{handler}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(resources_presenter_http_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{handler}}",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, handler) (rate(resources_presenter_http_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{handler}}",
          "refId": "D"
        }
      ],
      "title": "HTTP Latency",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "p95 latency broken down by handler phase. The \"total\" series is the overall handler latency (http.duration_seconds) and is the reference against which per-phase contributions can be compared. Custom histogram buckets (0.001 s … 10 s) resolve sub-millisecond phases (parse, serialize) and multi-second phases (rbac_authz, query).",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "id": 5,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, handler, phase) (rate(resources_presenter_http_phase_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{handler}} {{phase}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(resources_presenter_http_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 total {{handler}}",
          "refId": "B"
        }
      ],
      "title": "Handler Phase Latency (p95)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Full latency distribution across all handler phases at p50, p75, p95, and p99. The \"total\" series (sourced from http.duration_seconds) is the true end-to-end handler time and serves as a reference ceiling. Per-phase series use http.phase.duration_seconds.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 9,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, handler, phase) (rate(resources_presenter_http_phase_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{handler}} {{phase}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.75, sum by (le, handler, phase) (rate(resources_presenter_http_phase_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p75 {{handler}} {{phase}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, handler, phase) (rate(resources_presenter_http_phase_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{handler}} {{phase}}",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, handler, phase) (rate(resources_presenter_http_phase_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{handler}} {{phase}}",
          "refId": "D"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le, handler) (rate(resources_presenter_http_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 total {{handler}}",
          "refId": "E"
        },
        {
          "expr": "histogram_quantile(0.75, sum by (le, handler) (rate(resources_presenter_http_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p75 total {{handler}}",
          "refId": "F"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(resources_presenter_http_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 total {{handler}}",
          "refId": "G"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, handler) (rate(resources_presenter_http_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 total {{handler}}",
          "refId": "H"
        }
      ],
      "title": "Handler Phase Latency (p50 / p75 / p95 / p99)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Rate of resources returned per second by each handler. Y-axis unit is \"short\" (SI-suffixed number/s) rather than ops because the metric counts domain objects, not operations.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "id": 6,
      "targets": [
        {
          "expr": "sum by (handler) (rate(resources_presenter_http_resources_returned_total[$__rate_interval]))",
          "legendFormat": "{{handler}}",
          "refId": "A"
        }
      ],
      "title": "Resources Returned",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Rate of Kubernetes targets discovered (before RBAC) vs. allowed (after RBAC filtering) per second. A growing gap between discovered and allowed indicates increasing RBAC denials.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "id": 7,
      "targets": [
        {
          "expr": "sum by (handler) (rate(resources_presenter_http_discovery_targets_total[$__rate_interval]))",
          "legendFormat": "discovered {{handler}}",
          "refId": "A"
        },
        {
          "expr": "sum by (handler) (rate(resources_presenter_http_rbac_targets_allowed_total[$__rate_interval]))",
          "legendFormat": "allowed {{handler}}",
          "refId": "B"
        }
      ],
      "title": "Discovery And RBAC Targets",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "p95 of the time spent waiting for PostgreSQL to become ready at service startup. This histogram is recorded once per pod start; raw bucket counts (no rate()) are used so that the metric remains visible after the startup transient has passed.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "id": 8,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (resources_presenter_db_connect_duration_seconds_bucket))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "title": "DB Connect Latency",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "krateo",
    "resources-presenter",
    "opentelemetry"
  ],
  "templating": {
    "list": [
