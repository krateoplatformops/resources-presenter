{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Cumulative count of successful and failed service startups since pod creation. Uses raw counter values (no rate/increase) because this metric is emitted exactly once at startup. The line shows a step from 0 to 1 at the moment the process started.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum(resources_presenter_startup_success_total)",
          "legendFormat": "success",
          "refId": "A"
        },
        {
          "expr": "sum(resources_presenter_startup_failure_total)",
          "legendFormat": "failure",
          "refId": "B"
        }
      ],
      "title": "Startup",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "sum by (handler, method) (rate(resources_presenter_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{handler}} {{method}}",
          "refId": "A"
        }
      ],
      "title": "HTTP Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (handler, stage) (rate(resources_presenter_http_errors_total[$__rate_interval]))",
          "legendFormat": "{{handler}} {{stage}}",
          "refId": "A"
        }
      ],
      "title": "HTTP Error Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "End-to-end HTTP handler latency at p50, p75, p95, and p99. Does NOT include upstream middleware time (JWT validation, UserConfig). Custom histogram buckets (0.05 s … 10 s) provide accurate interpolation across the 1–6 s hot range.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 4,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, handler) (rate(resources_presenter_http_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{handler}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.75, sum by (le, handler) (rate(resources_presenter_http_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p75 {{handler}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(resources_presenter_http_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{handler}}",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, handler) (rate(resources_presenter_http_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{handler}}",
          "refId": "D"
        }
      ],
      "title": "HTTP Latency",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "p50 handler latency split by phase. \"total\" comes from http.duration_seconds (the true end-to-end time). Per-phase series come from http.phase.duration_seconds. Custom buckets resolve phases from < 1 ms (parse) to > 3 s (rbac_authz).",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "id": 10,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, handler, phase) (rate(resources_presenter_http_phase_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{handler}} {{phase}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le, handler) (rate(resources_presenter_http_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "total {{handler}}",
          "refId": "B"
        }
      ],
      "title": "Handler Phase Latency (p50)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "p75 handler latency split by phase. \"total\" comes from http.duration_seconds (the true end-to-end time). Per-phase series come from http.phase.duration_seconds.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "id": 11,
      "targets": [
        {
          "expr": "histogram_quantile(0.75, sum by (le, handler, phase) (rate(resources_presenter_http_phase_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{handler}} {{phase}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.75, sum by (le, handler) (rate(resources_presenter_http_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "total {{handler}}",
          "refId": "B"
        }
      ],
      "title": "Handler Phase Latency (p75)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "p95 handler latency split by phase. \"total\" comes from http.duration_seconds (the true end-to-end time). Per-phase series come from http.phase.duration_seconds.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "id": 12,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, handler, phase) (rate(resources_presenter_http_phase_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{handler}} {{phase}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(resources_presenter_http_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "total {{handler}}",
          "refId": "B"
        }
      ],
      "title": "Handler Phase Latency (p95)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "p99 handler latency split by phase. \"total\" comes from http.duration_seconds (the true end-to-end time). Per-phase series come from http.phase.duration_seconds.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "id": 13,
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, handler, phase) (rate(resources_presenter_http_phase_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{handler}} {{phase}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, handler) (rate(resources_presenter_http_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "total {{handler}}",
          "refId": "B"
        }
      ],
      "title": "Handler Phase Latency (p99)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Average handler time decomposed into sequential phases as a stacked area chart. Because phases execute sequentially, average durations add up correctly: avg(phase_A) + avg(phase_B) + … ≈ avg(total). This is mathematically valid for averages but NOT for quantiles — do not stack the p50/p75/p95/p99 panels above. The dashed overlay is the true average total from http.duration_seconds and acts as a sanity-check ceiling.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 70,
            "lineWidth": 1,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "group": "A",
                  "mode": "none"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [10, 10],
                  "fill": "dash"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "id": 14,
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "rate(resources_presenter_http_phase_duration_seconds_sum[$__rate_interval]) / rate(resources_presenter_http_phase_duration_seconds_count[$__rate_interval])",
          "legendFormat": "{{handler}} {{phase}}",
          "refId": "A"
        },
        {
          "expr": "sum by (handler) (rate(resources_presenter_http_duration_seconds_sum[$__rate_interval])) / sum by (handler) (rate(resources_presenter_http_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "avg total {{handler}}",
          "refId": "B"
        }
      ],
      "title": "Phase Contribution — Average Breakdown (stacked)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Number of resources returned per Grafana step interval (increase, not rate). Values are whole-number counts of domain objects. Uses increase() so the Y-axis shows integers rather than a fractional per-second rate.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "id": 6,
      "targets": [
        {
          "expr": "sum by (handler) (increase(resources_presenter_http_resources_returned_total[$__rate_interval]))",
          "legendFormat": "{{handler}}",
          "refId": "A"
        }
      ],
      "title": "Resources Returned",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Number of Kubernetes targets discovered (before RBAC) vs. allowed (after RBAC filtering) per Grafana step interval (increase, not rate). Values are whole-number counts. A growing gap between discovered and allowed indicates increasing RBAC denials.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "id": 7,
      "targets": [
        {
          "expr": "sum by (handler) (increase(resources_presenter_http_discovery_targets_total[$__rate_interval]))",
          "legendFormat": "discovered {{handler}}",
          "refId": "A"
        },
        {
          "expr": "sum by (handler) (increase(resources_presenter_http_rbac_targets_allowed_total[$__rate_interval]))",
          "legendFormat": "allowed {{handler}}",
          "refId": "B"
        }
      ],
      "title": "Discovery And RBAC Targets",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "p95 of the time spent waiting for PostgreSQL to become ready at service startup. This histogram is recorded once per pod start; raw bucket counts (no rate()) are used so that the metric remains visible after the startup transient has passed.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 45
      },
      "id": 8,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (resources_presenter_db_connect_duration_seconds_bucket))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "title": "DB Connect Latency",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "krateo",
    "resources-presenter",
    "opentelemetry"
  ],
